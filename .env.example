# Server
PORT=3015

# Supabase — assignments, assignment_submissions, users, teacher_student, user_preferences
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq — quiz/submission grading, explanations, quiz generation
GROQ_API_KEY=

# Qdrant — textbook grounding for generate-quiz and worksheet-image grading
QDRANT_URL=
QDRANT_API_KEY=

# Public origin of this service, baked into rendered worksheets so the student
# IME can reach /quiz/transliterate from inside the app's iframe. Optional on
# Render (RENDER_EXTERNAL_URL is used automatically).
PUBLIC_URL=

# AI accounts: only Gemini and Groq are used.
# Gemini — reads the worksheet (PDF/pictures). Comma-separated models, tried in order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash
# Groq vision (same GROQ_API_KEY) — second picture reader when Gemini is busy.
# Comma-separated, tried in order.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Time budgets for the worksheet pipeline (ms).
GEMINI_TIMEOUT_WITH_FALLBACK_MS=30000
# Background worksheet jobs keep trying to read the pictures with vision AI
# (Gemini, then Groq vision, then Gemini again) for this long before building a
# text-only quiz. Sync /quiz/generate(-image) keep GEMINI_VISION_TIMEOUT_MS.
VISION_TOTAL_BUDGET_MS=240000
# Tried after GEMINI_MODEL when every configured model is busy (503) or over
# its per-model quota. Set empty to disable.
GEMINI_EXTRA_MODELS=gemini-flash-latest,gemini-flash-lite-latest
DOCUMENT_MODEL_TIMEOUT_MS=150000
# Chrome/Edge used for Word → PDF and PDF page rendering. Optional: by default
# Puppeteer's own Chrome (npx puppeteer browsers install chrome) or an installed
# Chrome / Edge is found automatically. Windows example:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=
FIREBASE_SERVICE_ACCOUNT_B64=   # base64 Firebase service-account JSON - for the teacher library sign-in check
